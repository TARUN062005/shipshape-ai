# Copy this file to .env in the repository root, or to backend/.env.
# Never commit the filled-in file. Never put these values in frontend code
# or in any VITE_ variable. Vite exposes VITE_ variables to the browser.

PORT=8787
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# Optional. A token raises the public GitHub API rate limit.
# Classic or fine-grained tokens need only public repository read access.
GITHUB_TOKEN=

# Server-side only. Create a key at https://bharatcode.ai/account
BHARATCODE_API_KEY=
BHARATCODE_MODEL=qwen-3.8-27b
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1

# Per-IP limit for POST /api/audit. Health checks are not limited.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
